#!/bin/sh
# Wrapper executable for this project's CLI (cli.py), under a short, fixed
# name ("leetnotes") — Click's shell-completion hooks resolve the program
# they complete for via a PATH lookup (through `env`), so a shell function
# or alias doesn't work here; this needs to be a real executable on PATH.
# See shell/README.md for how to install this + tab-completion.
#
# Resolves its own real location (even invoked through a symlink on PATH,
# which is how it's meant to be installed) and cd's there before running,
# so it works from any directory — same as this project's settings (which
# resolve `.env` relative to the process's cwd) expect.
set -e

script_path=$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")
repo_root=$(cd "$(dirname "$script_path")/.." && pwd)

cd "$repo_root"
exec uv run python cli.py "$@"
