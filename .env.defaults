# Shipped defaults for every non-secret setting. Committed — safe to read,
# diff, and share; nothing in here is a credential. Loaded before .env, so
# .env (gitignored — your LeetCode credentials, plus any personal override)
# always wins for a key set in both. To change one of these just for
# yourself, don't edit this file — add the same KEY=value to your own .env.

# `notes prefill` — generates draft notes content (pattern/core idea/
# invariant/...) via a pluggable CLI AI tool. Defaults to Claude Code itself
# (`claude -p`, no separate API key needed — billed against your Claude Code
# subscription). See modules/ai_prefill/settings.py for every option,
# including rate limiting and response size limits.
AI_PREFILL_PROVIDER=claude_code
AI_PREFILL_MODEL=sonnet

# Only used when AI_PREFILL_PROVIDER=command — point this at any other CLI
# AI tool's invocation to swap the backend without touching Python, e.g.:
#   AI_PREFILL_COMMAND=ollama run llama3
# AI_PREFILL_COMMAND=
# AI_PREFILL_SYSTEM_PROMPT_FLAG=
# AI_PREFILL_ENVELOPE_KEY=

# Overrides the default LOCAL_RENDER/ output dir for rendered problems/notes.
# A CLI --output-base always wins over this. Point it at (a folder inside)
# your Obsidian vault to render straight into it — that's a personal path,
# so set it in your own .env rather than editing the blank default here.
OUTPUT_BASE_DIR=

# Default `notes render --style` ("plain" or "obsidian"), so you don't have
# to pass --style on every invocation. A CLI --style always wins over this.
DEFAULT_NOTES_STYLE=plain

# Set to false to stop echoing logs to the terminal (e.g. during a big --all
# batch run). File logging (logs/leetcode_pipeline.log) always happens
# either way.
LOG_CONSOLE_ENABLED=true
