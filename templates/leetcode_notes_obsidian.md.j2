{# Personal study-notes template with Obsidian features (wikilinks, callouts).
   Data vars (from the sync pipeline): frontend_id, slug, title, difficulty, url
   Tag var: tags — personal pattern tags + LeetCode question-tag slugs, combined
   Linking vars: problem_remote_link, problem_local_link — vault-relative wikilink
     targets (no extension) for the two already-rendered problem/solution files
   Prefill vars (all optional — pass None/empty to leave blank for manual fill):
     aliases, related, problem_summary, pattern, core_idea, invariant,
     trap, recognition_clue, complexity_time, complexity_space, takeaway #}
{% macro bullets(items) -%}
    {%- if items -%}
        {{ "- " ~ items | join("\n- ") }}
    {%- else -%}
        -
    {%- endif -%}
{% endmacro -%}
{% macro callout(kind, text) -%}
    > [!{{ kind }}]
    > {{ text or '' }}
{%- endmacro -%}
---
id: {{ frontend_id }}
slug: {{ slug }}
aliases: [{% for a in aliases %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
tags:
{% for t in tags %}
          - {{ t }}
{% endfor %}
difficulty: {{ difficulty }}
platform: LeetCode
problem_link: "{{ url }}"
{% if related %}
        related:
        {% for r in related %}
              - "[[{{ r }}]]"
        {% endfor %}
{% endif %}
---
# {{ frontend_id }}. {{ title }}
🔗 **Problem & Solution:** [[{{ problem_remote_link }}|Remote]] · [[{{ problem_local_link }}|Local]]
---

**Problem:**
{{ callout('quote', problem_summary) }}

**Pattern:**
{{ bullets(pattern) }}

**Core idea:**
{{ bullets(core_idea) }}

**Invariant:**
{{ bullets(invariant) }}

**Trap:**
{{ bullets(trap) }}

**Recognition clue:**
{{ bullets(recognition_clue) }}

**Complexity:**
- Time: `{{ complexity_time or '' }}`
- Space: `{{ complexity_space or '' }}`

**My takeaway:**
{{ bullets(takeaway) }}
{% if related %}

        ---
    **Related:**
    {% for r in related %}
        - [[{{ r }}]]
    {% endfor %}
{% endif %}
