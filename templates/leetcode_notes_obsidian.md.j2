{# Personal study-notes template with Obsidian features (wikilinks).
   Data vars (from the sync pipeline): frontend_id, slug, title, difficulty, url
   Tag var: tags — personal pattern tags + LeetCode question-tag slugs, combined
   Linking vars: problem_remote_link (always set), problem_local_link (None
     when the problem has no local variant) — vault-relative wikilink targets
     (no extension) for the rendered problem/solution file(s)
   Prefill vars (all optional — pass None/empty to leave blank for manual fill):
     aliases, related, problem_summary, pattern, core_idea, invariant,
     trap, recognition_clue, complexity_time, complexity_space, takeaway
   flashcards: list[str], deterministic deck-tag scaffold for the Obsidian
     Spaced Repetition plugin — NOT part of AI prefill (see
     modules/render/markdown_notes.py::_flashcard_deck_tags): one
     "#flashcards/DSA/<tag>" line per note tag, plus
     "#flashcards/DSA/problems/<slug>", no cards. Cards are added by hand. #}
{% macro bullets(items) -%}
    {%- if items -%}
        {{ "- " ~ items | join("\n- ") }}
    {%- else -%}
        -
    {%- endif -%}
{% endmacro -%}
---
id: {{ frontend_id }}
slug: {{ slug }}
aliases: [{% for a in aliases %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
tags:
{% for t in tags %}
 - {{ t }}
{% endfor %}
difficulty: {{ difficulty }}
platform: LeetCode
problem_link: "{{ url }}"
{% if related %}
  related:
  {% for r in related %}
        - "[[{{ r }}]]"
  {% endfor %}
{% endif %}

---

# {{ frontend_id }}. {{ title }}
### 🔗 **Problem & Solution:** {% if problem_local_link %}[[{{ problem_remote_link }}|Remote]] · [[{{ problem_local_link }}|Local]]{% else %}[[{{ problem_remote_link }}|Link]]{% endif %}



**Problem:**
> {{ problem_summary or '' }}

**Pattern:**
{{ bullets(pattern) }}

**Core idea:**
{{ bullets(core_idea) }}

**Invariant:**
{{ bullets(invariant) }}

**Trap:**
{{ bullets(trap) }}

**Recognition clue:**
{{ bullets(recognition_clue) }}

**Complexity:**
- Time: `{{ complexity_time or 'O(?)' }}`
- Space: `{{ complexity_space or 'O(?)' }}`

**My takeaway:**
{{ bullets(takeaway) }}
{% if related %}

                            ---
    **Related:**
    {% for r in related %}
        - [[{{ r }}]]
    {% endfor %}
{% endif %}
{% if flashcards %}

> [!info]- Flashcards
{% for line in flashcards %}
> {{ line }}
{% endfor %}
{% endif %}
