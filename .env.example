# This file is only for your personal LeetCode credentials/identity —
# secrets that must never be committed. .env is gitignored; copy this file
# to .env and fill it in.
#
# Every other setting (output dir, notes style, AI provider, logging, ...)
# ships with a committed default in .env.defaults — nothing to fill in there
# unless you want to override one just for yourself, in which case add the
# same KEY=value to your own .env below; .env always wins over .env.defaults.

LEETCODE_CSRF_TOKEN=
LEETCODE_SESSION=

# Optional: your public LeetCode username, only needed for the `recent`
# command group (recentAcSubmissionList).
LEETCODE_USERNAME=
