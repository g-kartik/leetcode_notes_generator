# Copy this file to .env and fill in what you need. .env is gitignored —
# nothing you put there ever gets committed. This file is just a template;
# it isn't read at runtime itself.
#
# Every setting below already has a sensible default baked into the Python
# settings class it belongs to (see the file noted on each one) — you only
# need to set a line here if you want something different from that default
# on this machine/account. Leave the rest out entirely.

LEETCODE_CSRF_TOKEN=
LEETCODE_SESSION=

# Optional: your public LeetCode username, only needed for the `recent`
# command group (recentAcSubmissionList).
LEETCODE_USERNAME=

# Optional: overrides the default LOCAL_RENDER/ output dir for rendered
# problems/notes. A CLI --output-base always wins over this. Point it at
# (a folder inside) your Obsidian vault to render straight into it. This is
# a local filesystem path — keep it in your own .env, never commit it.
# See modules/render/settings.py.
OUTPUT_BASE_DIR=

# Optional: default `notes render --style` ("plain" or "obsidian"), so you
# don't have to pass --style on every invocation. A CLI --style always wins
# over this. Code default: "plain". See modules/render/settings.py.
DEFAULT_NOTES_STYLE=

# Optional: `notes prefill` — generates draft notes content (pattern/core
# idea/invariant/...) via a pluggable CLI AI tool. Code default runs Claude
# Code itself (`claude -p`, no separate API key needed — billed against your
# Claude Code subscription). Only set these if you want a different
# tool/model than that default. See modules/ai_prefill/settings.py for every
# option, including rate limiting and response size limits.
AI_PREFILL_PROVIDER=
AI_PREFILL_MODEL=

# Only used when AI_PREFILL_PROVIDER=command — point this at any other CLI
# AI tool's invocation to swap the backend without touching Python, e.g.:
#   AI_PREFILL_COMMAND=ollama run llama3
AI_PREFILL_COMMAND=
AI_PREFILL_SYSTEM_PROMPT_FLAG=
AI_PREFILL_ENVELOPE_KEY=

# Optional: set to false to stop echoing logs to the terminal (e.g. during a
# big --all batch run). File logging (logs/leetcode_pipeline.log) always
# happens either way. Code default: true. See logging_config.py.
LOG_CONSOLE_ENABLED=
